{
  "compilerOptions": {
    "target": "es2020",
    "lib": [
      "esnext",
      "es2024",
      "es7",
      "webworker",
      "es5",
      "es6",
      "dom",
      "dom.iterable"
    ],
    "module": "NodeNext",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "moduleResolution": "NodeNext"
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "examples"],
  "ts-node": {
    "esm": true
  }
}
